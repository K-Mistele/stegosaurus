{
  "name": "@stegosaurus/effect-ai-openai",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "HumanLayer's vendored OpenAI provider for Effect AI SDK",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "scripts": {
    "typecheck": "tsc && tsc -p tsconfig.build.json",
    "test": "vp test test/HumanlayerFork.test.ts"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
