                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./skills": {
                "types": "./dist/Skills/DiskSkills.d.ts",
                "import": "./dist/Skills/DiskSkills.js",
                "default": "./dist/Skills/DiskSkills.js"
            },
            "./tools/files": {
                "types": "./dist/Tools/FileTools.d.ts",
                "import": "./dist/Tools/FileTools.js",
                "default": "./dist/Tools/FileTools.js"
            }
        }
    },
    "scripts": {
        "typecheck": "tsrs",
        "test": "vp test"
    },
    "dependencies": {
        "@silvia-odwyer/photon-node": "catalog:",
        "@stegosaurus/fold-codex": "workspace:*",
